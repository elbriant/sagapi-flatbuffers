
enum Torappu_EvolvePhase : int32 {
	PHASE_0 = 0,
	PHASE_1 = 1,
	PHASE_2 = 2,
	PHASE_3 = 3,
	E_NUM = 4
}

table Torappu_CharacterData_UnlockCondition {
	phase:Torappu_EvolvePhase;
	level:int32;
}



table Torappu_Blackboard_DataPair {
	key:string;
	value:float;
	valueStr:string;
}



table Torappu_TalentData {
	unlockCondition:Torappu_CharacterData_UnlockCondition;
	requiredPotentialRank:int32;
	prefabKey:string;
	name:string;
	description:string;
	rangeId:string;
	blackboard:[Torappu_Blackboard_DataPair];
	tokenKey:string;
	isHideTalent:bool;
}



table Torappu_CharacterData_MasterData {
	level:int32;
	masterId:string;
	talentData:Torappu_TalentData;
}



table Torappu_CharacterData_MasterDataBundle {
	candidates:[Torappu_CharacterData_MasterData];
}



table dict__string__Torappu_CharacterData_MasterDataBundle {
  dict_key: string(key);
  dict_value: Torappu_CharacterData_MasterDataBundle;
}

table Torappu_SimpleKVTable_Torappu_CharacterData_MasterDataBundle {
  dict_array: [dict__string__Torappu_CharacterData_MasterDataBundle];
}

root_type Torappu_SimpleKVTable_Torappu_CharacterData_MasterDataBundle;